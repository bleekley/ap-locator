# Copy this file to .env and fill in real values. NEVER commit .env.
# .env is ignored by default. Never force-add credentials to Git.

# Credentials used for ALL controllers and switches unless overridden.
WLC_USERNAME=changeme
WLC_PASSWORD=changeme
WLC_ENABLE=changeme

# Optional separate credentials for switches (MAC-trace fallback only).
SWITCH_USERNAME=
SWITCH_PASSWORD=
SWITCH_ENABLE=

# Per-controller override when one box has different creds. NAME is the
# controller's name from controllers.csv, uppercased, dashes -> underscores.
# CRED_DENVER_2504_USERNAME=
# CRED_DENVER_2504_PASSWORD=
